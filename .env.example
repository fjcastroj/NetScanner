# NetScanner configuration. Copy to .env (ignored by Git) and replace every
# "change-me" value; the services refuse to start while a required secret is
# missing, empty or still "change-me". Never commit .env.

# --- Required secrets -------------------------------------------------------
# Application secret key, at least 32 characters. It also derives the key that
# encrypts the SNMP credential, so generate it, never choose it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it makes the stored SNMP credential unusable until it is saved again.
NETSCANNER_SECRET_KEY=change-me
# PostgreSQL password, used by the db service and by the backend services.
NETSCANNER_DB_PASSWORD=change-me

# --- Database ---------------------------------------------------------------
# Host name of the database inside the Compose network.
NETSCANNER_DB_HOST=db
# PostgreSQL port.
NETSCANNER_DB_PORT=5432
# Database name.
NETSCANNER_DB_NAME=netscanner
# Database user.
NETSCANNER_DB_USER=netscanner
# Seconds to wait for a database connection or health query.
NETSCANNER_DB_CONNECT_TIMEOUT=5

# --- API --------------------------------------------------------------------
# Address and port the API listens on inside its container.
NETSCANNER_API_HOST=0.0.0.0
NETSCANNER_API_PORT=8000

# --- Collector --------------------------------------------------------------
# Seconds between database checks while the collector is idle.
NETSCANNER_COLLECTOR_CHECK_INTERVAL=10
# Seconds between checks for a pending discovery run to start.
NETSCANNER_COLLECTOR_POLL_INTERVAL=2
# File touched on every collector loop, read by the container health check.
# Unset disables it; docker-compose.yml sets it inside the container.
# NETSCANNER_COLLECTOR_HEARTBEAT_FILE=/tmp/netscanner-collector.heartbeat

# --- Data -------------------------------------------------------------------
# Period after which data not confirmed again is shown as stale (ISO 8601
# duration, e.g. P7D or PT12H). Stale data is kept, never deleted.
NETSCANNER_STALE_AFTER=P7D

# --- SNMP client ------------------------------------------------------------
# Seconds to wait for each SNMP response (greater than 0, at most 60).
NETSCANNER_SNMP_TIMEOUT=3
# Retries after a timeout (0 to 5).
NETSCANNER_SNMP_RETRIES=1
# GETBULK max-repetitions (1 to 50).
NETSCANNER_SNMP_MAX_REPETITIONS=25
# Maximum rows per table walk; a walk that reaches it ends as partial.
NETSCANNER_SNMP_MAX_ROWS=200000
# Devices queried at the same time; each device gets one request at a time.
NETSCANNER_SNMP_MAX_DEVICES=8

# --- Discovery limits -------------------------------------------------------
# Ceilings for the limits an administrator may set per run. The values are
# hypotheses from the lab, to be reviewed after the first real run.
# Maximum depth from the seeds (0 to 32).
NETSCANNER_DISCOVERY_MAX_DEPTH=5
# Maximum distinct candidate addresses recorded per run.
NETSCANNER_DISCOVERY_MAX_CANDIDATES=4096
# Maximum devices queried per run.
NETSCANNER_DISCOVERY_MAX_DEVICES=256
# Maximum SNMP datagrams sent per run, retries and probes included.
NETSCANNER_DISCOVERY_MAX_DATAGRAMS=50000

# --- SNMP lab (docker-compose.lab.yml) -------------------------------------
# Community of the lab devices, fixed by the lab data files. It is accepted
# only by lab data; never use it on a real network. Not read by the services.
# NETSCANNER_LAB_COMMUNITY=netscanner-lab

# --- Administrator sessions (add-admin-authentication) ---------------------
# Initial values, to be reviewed. Durations as ISO 8601 (PT8H) or seconds.
# A session ends after this time without use.
NETSCANNER_SESSION_IDLE=PT8H
# A session ends this long after login, even when in use.
NETSCANNER_SESSION_MAX_AGE=PT24H
# Keep true. false is accepted only when NETSCANNER_WEB_BIND is a loopback
# address (127.0.0.1:<port> or [::1]:<port>); otherwise the API refuses to start.
NETSCANNER_SESSION_COOKIE_SECURE=true
# Only behind a reverse proxy with TLS: the origin the browser uses, as
# scheme://host[:port] with nothing else, e.g. https://netscanner.example.
# Unset, the allowed origins are http://localhost:<port> and
# http://127.0.0.1:<port> for the port of NETSCANNER_WEB_BIND.
# NETSCANNER_PUBLIC_ORIGIN=

# --- Logging ----------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.
NETSCANNER_LOG_LEVEL=INFO

# --- Deployment (docker-compose.yml only) -----------------------------------
# Host address and port where the web interface is published. Keep the
# default loopback binding unless you deliberately open it to the network.
# Also passed to the api service, for the Secure cookie check and the
# allowed origins. A bare port (8080) publishes on every interface.
NETSCANNER_WEB_BIND=127.0.0.1:8080
